# Lösenord som MeOS ska skicka i pwd-headern (Onlineresultat-inställningarna)
MEOS_PASSWORD=

# Katalog för persisterad tävlingsdata
DATA_DIR=./data

# Port för webbservern
PORT=3000

# Antal dagar tävlingsdata sparas innan den gallras automatiskt (KRAV-14).
# 0 stänger av gallringen.
RETENTION_DAYS=90

# E-postutskick av kvitto via Mailgun (KRAV-16). Saknas något av dessa är
# funktionen avstängd och mejlformuläret döljs.
# OBS: EU-domäner kräver smtp.eu.mailgun.org – US-endpointen ger
# "Authentication failed". Använd SMTP-lösenordet, inte API-nyckeln.
MAILGUN_SMTP=smtp.eu.mailgun.org
MAILGUN_USER=postmaster@din-domän.eu
MAILGUN_PWD=
# Valfria:
# MAILGUN_PORT=587
# MAIL_FROM=Digitalt kvitto <kvitto@din-domän.eu>
# MAIL_REPLY_TO=arrangoren@klubben.se
