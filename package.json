{
  "name": "meos-receipt",
  "version": "0.1.0",
  "description": "Digitalt kvitto för MeOS – visa din stämplingsutläsning i mobilen",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "bdd": "cucumber-js",
    "verify": "npm test && npm run bdd",
    "build:windows": "node tools/bygg-windowspaket.mjs",
    "build:exe": "node tools/bygg-exe.mjs",
    "build:exe:win": "node tools/bygg-exe.mjs --windows"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.1",
    "nodemailer": "^9.0.4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
