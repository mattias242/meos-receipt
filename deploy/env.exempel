# .env för tjänsten, läggs bredvid docker-compose.yml på servern.
# Checkas aldrig in – docker-compose läser den och skickar vidare variablerna
# till containern (containern läser inte .env själv).

# Samma lösenord som i MeOS Onlineresultat och i uppladdningsprogrammet.
# Utan det vägrar tjänsten starta: skrivändpunkterna ligger öppna mot internet.
MEOS_PASSWORD=

# Antal proxyled framför tjänsten. Cloudflare + DSM-nginx = 2 – avläst ur
# vhostens `proxy_add_x_forwarded_for`, inte gissat. Bekräfta ändå efter start:
# tools/verifiera-drift.sh mäter antalet och säger till om det inte stämmer.
TRUST_PROXY=2

# Porten på värden som containern mappas till – den proxyn pekar på. Står
# här och inte i docker-compose.yml, eftersom den filen skrivs över vid varje
# driftsättning medan .env ligger kvar.
HOST_PORT=3459

TZ=Europe/Stockholm
RETENTION_DAYS=90
READ_LIMIT=1000

# Mailgun EU. Användarnamnet måste vara en hel adress, och värdnamnet måste
# vara EU-endpointen – US-endpointen ger "Authentication failed" för EU-domäner.
MAILGUN_SMTP=smtp.eu.mailgun.org
MAILGUN_USER=
MAILGUN_PWD=
MAIL_FROM=Digitalt kvitto <samma adress som MAILGUN_USER>
MAIL_REPLY_TO=
