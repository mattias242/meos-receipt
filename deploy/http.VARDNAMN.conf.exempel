# nginx-vhost, mall. Byt <värdnamn> mot tjänstens värdnamn och spara som
# http.<värdnamn>.conf.
#
# Följer samma mönster som de vhostfiler som redan finns där: filen bor i projektet
# och installeras till /etc/nginx/conf.d/. DSM kan skriva över egna filer där
# vid större uppdateringar – kör då installationssteget igen (se
# DRIFTSATTNING.md).
#
# Kedjan är Cloudflare -> den här -> containern på 127.0.0.1:3459.
# X-Forwarded-For byggs på av båda leden, alltså TRUST_PROXY=2. Gissa inte:
# tjänsten mäter antalet och rapporterar det som "proxyhopp" i /api/health.

server {
    listen 80;
    server_name <värdnamn>;

    location / {
        proxy_pass http://127.0.0.1:3459;
        proxy_http_version 1.1;
        proxy_redirect off;

        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MeOS MOPComplete och IOF-resultatfiler är stora; tjänstens egen
        # gräns är 32 MB (KRAV-1). DSM:s nginx har redan 0 globalt, men
        # sätts här också så att vhosten inte beror på det.
        client_max_body_size 0;

        # En stor sändning från arenan över mobilnätet får ta sin tid.
        proxy_connect_timeout 1m;
        proxy_send_timeout    1m;
        proxy_read_timeout    1m;
    }
}

server {
    listen 443 ssl;
    server_name <värdnamn>;

    # Självsignerat origin-cert med SAN som täcker värdnamnet, som övriga värdnamn.
    # Fungerar eftersom Cloudflare står i SSL-läge "Full" – aldrig
    # "Full (strict)", som kräver ett certifikat Cloudflare litar på.
    ssl_certificate     /etc/ssl/certs/nas-origin.pem;
    ssl_certificate_key /etc/ssl/private/nas-origin.key;

    location / {
        proxy_pass http://127.0.0.1:3459;
        proxy_http_version 1.1;
        proxy_redirect off;

        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 0;

        proxy_connect_timeout 1m;
        proxy_send_timeout    1m;
        proxy_read_timeout    1m;
    }
}
